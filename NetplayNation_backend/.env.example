# Copy to .env. Never commit .env.
NODE_ENV=development
PORT=4000
MONGODB_URL=mongodb+srv://USER:PASS@cluster.mongodb.net/netplaynation
JWT_SECRET=change-me-to-a-long-random-string
# Leave Razorpay blank to run with Cash on Delivery only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Public URL of the site (used in email links). Required in production.
APP_URL=https://your-domain.com
# Transactional email. Leave blank in development: emails are printed to the console.
# Example (Brevo): smtps://LOGIN:SMTP_KEY@smtp-relay.brevo.com:465
SMTP_URL=
MAIL_FROM=Netplay Nation <orders@your-domain.com>
# Razorpay dashboard > Webhooks: URL https://your-domain.com/api/webhooks/razorpay, events payment.captured + order.paid
RAZORPAY_WEBHOOK_SECRET=
# Optional: image uploads from the admin panel (cloudinary.com > Dashboard). Without these, admins paste image links.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Used by `npm run seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
